    },
    {
      "id": "GOuji78aFjUMdezVl2Csi",
      "type": "text",
      "x": 5339.595549650469,
      "y": 4667.173869348392,
      "width": 884.4993286132812,
      "height": 75,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1O",
      "roundness": null,
      "seed": 355686323,
      "version": 355,
      "versionNonce": 598893107,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789955698097,
      "link": null,
      "locked": false,
      "text": "Daftar ini hanya bisa dilihat oleh kepala sekolah yang di tempatkan di cabang\ntersebut. bila kepala sekolah di tempatkan di banyak cabang, maka kepala sekolah tersebut\ndapat melakukan approval persetujuan ijin di cabang cabang tersebut",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Daftar ini hanya bisa dilihat oleh kepala sekolah yang di tempatkan di cabang\ntersebut. bila kepala sekolah di tempatkan di banyak cabang, maka kepala sekolah tersebut\ndapat melakukan approval persetujuan ijin di cabang cabang tersebut",
      "autoResize": true,
      "lineHeight": 1.25
    },
