{
    "name": "education-management-system-backend",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "bun build ./src/server.ts --target=node --outdir ./dist --minify && javascript-obfuscator dist --output dist",
        "dev": "bun --watch ./src/server.ts",
        "start": "bun ./dist/server.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bun": "latest",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.2.0",
        "@types/pg": "^8.23.1",
        "prettier": "^3.9.6"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@scalar/express-api-reference": "^0.10.16",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "express-rate-limit": "^8.6.2",
        "helmet": "^8.3.0",
        "javascript-obfuscator": "^5.5.0",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.3.0",
        "mysql2": "^3.23.3",
        "pg": "^8.23.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "zod": "^4.4.3"
    }
}
